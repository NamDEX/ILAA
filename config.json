  "timer": {
    "enabled_by_default": false,
    "duration_seconds": 600,
    "ui_display": "subtle",
    "auto_submit_on_expiry": true
  },
  "ui": {
    "show_overdue_banner": true,
    "mobile_friendly": true,
    "show_question_grid": true,
    "transitions": {
      "enabled": false,
      "style": "generic"
    }
  },
  "sets": {
    "cancel_marks_set_cancelled": true,
    "write_attempts_on_cancel": false
  },
  "logging": {
    "level": "DEBUG",
    "to_console": true,
    "to_file": true,
    "file_name": "app.log"
  }
