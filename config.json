{
  "app": {
    "host": "127.0.0.1",
    "port": 5000,
    "secret_key": "CHANGE_ME_TO_ANY_RANDOM_STRING"
  },
  "paths": {
    "question_bank_root": "C:\\Projects Python\\11+ question bank\\Question bank",
    "never_write_to_source": true,
    "data_dir": "data",
    "logs_dir": "logs",
    "exports_dir": "exports"
  },
  "practice": {
    "set_size": 10,
    "default_mode": "mixed",
    "overdue_days": 10
  },
  "mixed_mode": {
    "overdue_quota_fraction": 0.3,
    "weight_overdue_multiplier": 2.0,
    "weight_recent_wrong_multiplier": 2.5,
